{
  "name": "jcupupw",
  "version": "1.2.2",
  "description": "A lightweight modal dialog library for browsers, supporting Node.js (CommonJS) and browser global usage.",
  "main": "dist/jcupupw.cjs",
  "module": "dist/jcupupw.esm.js",
  "types": "types/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./dist/jcupupw.esm.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./dist/jcupupw.cjs"
      },
      "default": "./dist/jcupupw.esm.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rollup -c && node scripts/obfuscate.mjs",
    "dev": "rollup -c -w"
  },
  "keywords": [
    "modal",
    "dialog",
    "popup",
    "jcupupw"
  ],
  "author": "北啊呢 <177828525@qq.com> (https://github.com/ByUsiStudio)",
  "license": "MIT",
  "homepage": "https://github.com/ByUsiStudio/JCuPupw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByUsiStudio/JCuPupw.git"
  },
  "bugs": {
    "url": "https://github.com/ByUsiStudio/JCuPupw/issues"
  },
  "type": "module",
  "devDependencies": {
    "javascript-obfuscator": "^5.5.0",
    "less": "^4.9.1",
    "rollup": "^4.0.0",
    "rollup-plugin-obfuscator": "^1.1.0",
    "rollup-plugin-string": "^3.0.0"
  }
}
